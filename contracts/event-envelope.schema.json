{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M5mOsH Event Envelope",
  "description": "Metadata-only event contract for internal M5mOsH service communication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "source", "classification", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "component"],
      "properties": {
        "project_id": {"type": "string", "minLength": 2, "maxLength": 80},
        "component": {"type": "string", "minLength": 2, "maxLength": 80}
      }
    },
    "classification": {
      "type": "string",
      "enum": ["discovered", "observed", "verified", "historical", "planned"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["ok", "warning", "error", "unknown"]},
        "counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0},
          "maxProperties": 40
        },
        "fingerprints": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "duration_ms": {"type": "integer", "minimum": 0},
        "result_code": {"type": "string", "pattern": "^[A-Z0-9_.-]{1,48}$"}
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "kind", "captured_at"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 4, "maxLength": 128},
          "kind": {"type": "string", "enum": ["repository", "test", "health_check", "metric", "operator_record"]},
          "captured_at": {"type": "string", "format": "date-time"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
