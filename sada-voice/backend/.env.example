# Copy to .env for local development. Never commit real secrets.
APP_NAME=M5mOsH Voice Nexus API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./sada_voice.db
SECRET_KEY=generate-a-random-secret-of-at-least-32-characters
